# 複製這個檔案，改名成 .env，再把下面的值換成你自己 Supabase 專案的值。
# .env 已經加進 .gitignore，不會被 commit。

# Supabase 網頁 → Project Settings → Data API（或首頁的 Connect）→ Project URL
EXPO_PUBLIC_SUPABASE_URL=https://你的專案代號.supabase.co

# Supabase 網頁 → Project Settings → API Keys → Publishable key（sb_publishable_ 開頭）
# 注意：不要填 Secret key（sb_secret_ 開頭）或 service_role key。
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
