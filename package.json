{
  "name": "hibi",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/react": "~19.3.0",
    "kuromoji": "^0.1.2",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "ts-fsrs": "6.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx index.ts \"scripts/*.{mjs,ts}\"",
    "demo:build": "expo export --platform web --output-dir dist && node scripts/build-web-demo.mjs",
    "demo:smoke": "node scripts/smoke-web.mjs",
    "experiment": "tsx scripts/experiment.ts"
  },
  "private": true,
  "description": "Hibi 日々：從你的日常學日文。寫下今天，AI 挑出你明天用得到的單字，FSRS 演算法安排複習。"
}
